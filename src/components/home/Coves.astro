---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Title from '../Title.astro';
import Icon from '../Icon.astro';
import { COVE_IMAGES, sections } from '../../i18n/sections';
import { ROUTES, type Lang } from '../../site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = sections(lang).coves;
const photos = import.meta.glob<{ default: ImageMetadata }>('../../assets/photos/*.jpg', { eager: true });
const img = (n: string) => photos[`../../assets/photos/${n}.jpg`].default;
// Mozaik sütunları: [küçük, küçük], [uzun], [küçük, küçük], [uzun]
const cols = [[0, 1], [2], [3, 4], [5]];
---
<section class="section cv">
  <div class="cv__grid" data-car>
    <div class="cv__intro">
      <Title parts={c.title} class="title--lg" />
      <p class="sub">{c.text}</p>
      <a class="btn" href={`${ROUTES.tour[lang]}`}>{c.cta}</a>
    </div>
    <div class="cv__right">
      <div class="car__track cv__track">
        {cols.map((col) => (
          <div class:list={['cv__col', { 'cv__col--tall': col.length === 1 }]}>
            {col.map((i) => (
              <article class="cv__card" tabindex="0">
                <Image src={img(COVE_IMAGES[i])} alt={c.items[i].name} widths={[400, 700]} sizes="320px" />
                <div class="cv__body">
                  <h3>{c.items[i].name}</h3>
                  <p class="cv__tag">{c.items[i].tag}</p>
                  <p class="cv__text">{c.items[i].text}</p>
                </div>
              </article>
            ))}
          </div>
        ))}
      </div>
      <div class="car__arrows">
        <button class="car__btn" type="button" data-prev aria-label="‹"><Icon name="arrow-left" /></button>
        <button class="car__btn" type="button" data-next aria-label="›"><Icon name="arrow" /></button>
      </div>
    </div>
  </div>
</section>

<style>
  .cv__grid {
    display: grid;
    grid-template-columns: minmax(18rem, 26rem) 1fr;
    gap: 2.5rem;
    align-items: center;
    padding-left: max(var(--gutter), calc((100vw - var(--wrap)) / 2));
  }
  .cv__intro {
    display: grid;
    gap: 1rem;
    justify-items: start;
  }
  .cv__intro .sub {
    margin: 0 0 0.75rem;
  }
  .cv__right {
    min-width: 0;
  }
  .cv__track {
    gap: 1.1rem;
    padding-right: var(--gutter);
  }
  .cv__col {
    display: grid;
    grid-template-rows: 1fr 1fr;
    gap: 1.1rem;
    width: 19rem;
    height: 32rem;
  }
  .cv__col--tall {
    grid-template-rows: 1fr;
  }
  .cv__card {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-lg);
    color: #fff;
    outline-offset: 3px;
  }
  .cv__card :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s;
  }
  .cv__card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(6, 22, 40, 0.78), rgba(6, 22, 40, 0) 55%);
    transition: background 0.3s;
  }
  .cv__body {
    position: absolute;
    inset: auto 0 0;
    z-index: 1;
    padding: 1.1rem 1.25rem;
  }
  .cv__card h3 {
    color: #fff;
    font-size: 1.4rem;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.3);
  }
  .cv__tag {
    font-size: 0.9rem;
    opacity: 0.9;
  }
  .cv__text {
    font-size: 0.8125rem;
    line-height: 1.5;
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition: max-height 0.4s, opacity 0.3s, margin 0.3s;
  }
  .cv__card:hover :global(img),
  .cv__card:focus-visible :global(img) {
    transform: scale(1.05);
  }
  .cv__card:hover::after,
  .cv__card:focus-visible::after {
    background: linear-gradient(to top, rgba(6, 22, 40, 0.88), rgba(6, 22, 40, 0.15) 75%);
  }
  .cv__card:hover .cv__text,
  .cv__card:focus-visible .cv__text {
    max-height: 9rem;
    opacity: 1;
    margin-top: 0.5rem;
  }
  .car__arrows {
    margin-top: 0.5rem;
  }
  @media (max-width: 960px) {
    .cv__grid {
      grid-template-columns: 1fr;
    }
    .cv__intro {
      padding-right: var(--gutter);
    }
    .cv__col {
      width: 16rem;
      height: 26rem;
    }
    .cv__text {
      max-height: 9rem;
      opacity: 1;
      margin-top: 0.4rem;
    }
    .cv__col:not(.cv__col--tall) .cv__text {
      display: none;
    }
  }
</style>
