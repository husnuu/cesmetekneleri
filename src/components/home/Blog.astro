---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Title from '../Title.astro';
import Icon from '../Icon.astro';
import { sections } from '../../i18n/sections';
import type { Lang } from '../../site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const b = sections(lang).blog;
const BASE = 'https://cesmetekneturu.net/blog';
const photos = import.meta.glob<{ default: ImageMetadata }>('../../assets/photos/*.jpg', { eager: true });
const img = (n: string) => photos[`../../assets/photos/${n}.jpg`].default;
---
<section class="section bl">
  <div class="wrap" data-car>
    <Title parts={b.title} center class="title--lg" />
    <div class="car__track bl__track">
      {b.items.map((p) => (
        <a class="bl__card" href={`${BASE}/${p.slug}`} target="_blank" rel="noopener">
          <Image src={img(p.img)} alt={p.title} widths={[420, 700]} sizes="(max-width: 860px) 80vw, 25vw" />
          <div class="bl__body">
            <h3>{p.title}</h3>
            <p class="bl__date">{p.date}</p>
            <p class="bl__text">{p.text}</p>
          </div>
        </a>
      ))}
    </div>
    <div class="bl__foot">
      <div class="car__arrows">
        <button class="car__btn" type="button" data-prev aria-label="‹"><Icon name="arrow-left" /></button>
        <button class="car__btn" type="button" data-next aria-label="›"><Icon name="arrow" /></button>
      </div>
      <a class="btn" href={BASE} target="_blank" rel="noopener">{b.cta}</a>
    </div>
  </div>
</section>

<style>
  .bl__track {
    margin-top: 2.5rem;
  }
  .bl__card {
    width: calc((100% - 2.5rem) / 3);
    display: flex;
    flex-direction: column;
    text-decoration: none;
  }
  .bl__card :global(img) {
    width: 100%;
    aspect-ratio: 16 / 11;
    object-fit: cover;
    border-radius: 22px;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1), box-shadow 0.4s;
  }
  .bl__card:hover :global(img) {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }
  .bl__body {
    display: grid;
    gap: 0.4rem;
    padding: 1.1rem 0.15rem 0;
  }
  .bl__date {
    order: -1;
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--primary);
  }
  .bl__card h3 {
    font-size: 1.125rem;
    line-height: 1.35;
    transition: color 0.2s;
  }
  .bl__card:hover h3 {
    color: var(--primary);
  }
  .bl__text {
    font-size: 0.9rem;
    color: var(--muted);
  }
  .bl__foot {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }
  .bl__foot .car__arrows {
    align-self: flex-start;
  }
  @media (max-width: 860px) {
    .bl__card {
      width: 80%;
    }
  }
</style>
