---
// Elle çizilmiş, hafif hareketli illüstrasyon ikonlar (sallanan tekne, akan dalga, dönen ibre...).
// prefers-reduced-motion açıkken hareket durur.
export type AnimName = 'boat' | 'sun' | 'clock' | 'grill' | 'swim' | 'shield' | 'pin' | 'bus' | 'users' | 'shower' | 'seat' | 'calendar' | 'cloud' | 'cup' | 'lifebuoy' | 'chat' | 'phone' | 'mail';
interface Props { name: AnimName; size?: number; class?: string }
const { name, size = 56, class: cls } = Astro.props;
---
<svg class:list={['ai', `ai--${name}`, cls]} width={size} height={size} viewBox="0 0 64 64" aria-hidden="true">
  {name === 'boat' && (
    <>
      <circle cx="48" cy="14" r="6" class="c-sun" />
      <g class="bob">
        <path d="M30 13v15h12z" class="c-acc" />
        <path d="M29 12v17" class="s-ink" />
        <rect x="18" y="29" width="24" height="9" rx="2" class="c-soft" />
        <rect x="21" y="31.5" width="4" height="3.5" rx="1" class="c-pri" />
        <rect x="28" y="31.5" width="4" height="3.5" rx="1" class="c-pri" />
        <rect x="35" y="31.5" width="4" height="3.5" rx="1" class="c-pri" />
        <path d="M9 38h46l-6.5 9h-33z" class="c-pri" />
      </g>
      <g class="wave"><path d="M-16 50c4 0 4 3 8 3s4-3 8-3 4 3 8 3 4-3 8-3 4 3 8 3 4-3 8-3 4 3 8 3 4-3 8-3 4 3 8 3 4-3 8-3 4 3 8 3" class="s-pri" /></g>
      <g class="wave wave--2"><path d="M-16 57c4 0 4 3 8 3s4-3 8-3 4 3 8 3 4-3 8-3 4 3 8 3 4-3 8-3 4 3 8 3 4-3 8-3 4 3 8 3 4-3 8-3 4 3 8 3" class="s-soft" /></g>
    </>
  )}
  {name === 'sun' && (
    <>
      <g class="spin">
        {[0, 45, 90, 135, 180, 225, 270, 315].map((a) => (
          <path d="M32 6v7" class="s-acc" transform={`rotate(${a} 32 32)`} />
        ))}
      </g>
      <circle cx="32" cy="32" r="12" class="c-acc pulse" />
      <g class="drift"><path d="M8 50a6 6 0 0 1 11-3 5 5 0 0 1 8 4H8z" class="c-soft" /></g>
    </>
  )}
  {name === 'clock' && (
    <>
      <circle cx="32" cy="32" r="23" class="c-soft" />
      <circle cx="32" cy="32" r="23" class="s-pri" />
      {[0, 90, 180, 270].map((a) => <path d="M32 12v4" class="s-pri" transform={`rotate(${a} 32 32)`} />)}
      <path d="M32 32V21" class="s-ink hand-h" />
      <path d="M32 32V15" class="s-acc hand-m" />
      <circle cx="32" cy="32" r="2.5" class="c-pri" />
    </>
  )}
  {name === 'grill' && (
    <>
      <path d="M24 10c-3 4 3 6 0 10" class="s-soft steam" />
      <path d="M32 8c-3 4 3 6 0 10" class="s-soft steam steam--2" />
      <path d="M40 10c-3 4 3 6 0 10" class="s-soft steam steam--3" />
      <path d="M17 28c5 7 9 7 9 7s3-6 12-6c6 0 9 4 9 4s-3 5-9 5c-9 0-12-6-12-6" class="c-acc" />
      <circle cx="41" cy="31" r="1.2" class="c-ink" />
      <path d="M10 37h44a22 12 0 0 1-44 0z" class="c-pri" />
      <path d="M22 49l-4 8M42 49l4 8" class="s-ink" />
      <path d="M13 38h38" class="s-light" />
    </>
  )}
  {name === 'swim' && (
    <>
      <g class="bob">
        <circle cx="26" cy="27" r="6" class="c-acc" />
        <path d="M33 30c6-8 14-9 18-6" class="s-pri arm" />
      </g>
      <g class="wave"><path d="M-16 38c4 0 4 3 8 3s4-3 8-3 4 3 8 3 4-3 8-3 4 3 8 3 4-3 8-3 4 3 8 3 4-3 8-3 4 3 8 3 4-3 8-3 4 3 8 3" class="s-pri" /></g>
      <g class="wave wave--rev"><path d="M-16 47c4 0 4 3 8 3s4-3 8-3 4 3 8 3 4-3 8-3 4 3 8 3 4-3 8-3 4 3 8 3 4-3 8-3 4 3 8 3 4-3 8-3 4 3 8 3" class="s-soft" /></g>
      <g class="wave"><path d="M-16 56c4 0 4 3 8 3s4-3 8-3 4 3 8 3 4-3 8-3 4 3 8 3 4-3 8-3 4 3 8 3 4-3 8-3 4 3 8 3 4-3 8-3 4 3 8 3" class="s-pri" /></g>
    </>
  )}
  {name === 'shield' && (
    <>
      <path d="M32 7 12 14v15c0 13 9 23 20 28 11-5 20-15 20-28V14z" class="c-soft" />
      <path d="M32 7 12 14v15c0 13 9 23 20 28 11-5 20-15 20-28V14z" class="s-pri" />
      <path d="m22 32 7 7 14-15" class="s-acc draw" />
      <circle cx="49" cy="12" r="2" class="c-acc twinkle" />
      <circle cx="54" cy="20" r="1.3" class="c-pri twinkle twinkle--2" />
    </>
  )}
  {name === 'pin' && (
    <>
      <ellipse cx="32" cy="56" rx="10" ry="2.5" class="c-soft shadow" />
      <g class="hop">
        <path d="M32 50S16 35 16 24a16 16 0 0 1 32 0c0 11-16 26-16 26z" class="c-pri" />
        <circle cx="32" cy="24" r="6" class="c-white" />
        <circle cx="32" cy="24" r="2.5" class="c-acc" />
      </g>
    </>
  )}
  {name === 'bus' && (
    <>
      <g class="road"><path d="M-8 58h10M12 58h10M32 58h10M52 58h10M72 58h10" class="s-soft" /></g>
      <g class="bob bob--fast">
        <rect x="8" y="18" width="46" height="28" rx="6" class="c-pri" />
        <rect x="12" y="22" width="9" height="9" rx="2" class="c-white" />
        <rect x="24" y="22" width="9" height="9" rx="2" class="c-white" />
        <rect x="36" y="22" width="9" height="9" rx="2" class="c-white" />
        <rect x="47" y="22" width="5" height="12" rx="1.5" class="c-soft" />
        <rect x="50" y="38" width="4" height="3" rx="1" class="c-acc" />
      </g>
      <g class="wheel" style="transform-origin:20px 47px"><circle cx="20" cy="47" r="5" class="c-ink" /><path d="M20 43v8M16 47h8" class="s-light" /></g>
      <g class="wheel" style="transform-origin:44px 47px"><circle cx="44" cy="47" r="5" class="c-ink" /><path d="M44 43v8M40 47h8" class="s-light" /></g>
    </>
  )}
  {name === 'users' && (
    <>
      <g class="bob bob--late">
        <circle cx="43" cy="22" r="7" class="c-soft" />
        <path d="M30 50c0-9 6-15 13-15s13 6 13 15z" class="c-soft" />
      </g>
      <g class="bob">
        <circle cx="25" cy="24" r="8" class="c-acc" />
        <path d="M9 54c0-10 7-17 16-17s16 7 16 17z" class="c-pri" />
      </g>
    </>
  )}
  {name === 'shower' && (
    <>
      <path d="M16 10h16a6 6 0 0 1 6 6v4" class="s-ink" />
      <path d="M26 22h24l-3 6H29z" class="c-pri" />
      {[30, 36, 42].map((x, i) => <path d={`M${x} 33v5`} class={`s-pri drop drop--${i + 1}`} />)}
      {[33, 39, 45].map((x, i) => <path d={`M${x} 40v5`} class={`s-soft drop drop--${i + 2}`} />)}
      <ellipse cx="38" cy="56" rx="14" ry="3" class="c-soft" />
    </>
  )}
  {name === 'seat' && (
    <>
      <g class="sway">
        <path d="M30 8v40" class="s-ink" />
        <path d="M10 22c2-9 11-14 20-14s18 5 20 14z" class="c-acc" />
        <path d="M10 22c4-3 7-3 10 0 3-3 7-3 10 0 3-3 7-3 10 0 3-3 6-3 10 0" class="s-light" />
      </g>
      <path d="M12 46h22l10-12" class="s-pri" />
      <path d="M16 46l-3 8M30 46l3 8" class="s-ink" />
      <path d="M4 56h56" class="s-soft" />
    </>
  )}
  {name === 'calendar' && (
    <>
      <rect x="10" y="14" width="44" height="40" rx="6" class="c-white" />
      <rect x="10" y="14" width="44" height="40" rx="6" class="s-pri" />
      <path d="M10 26h44" class="s-pri" />
      <rect x="10" y="14" width="44" height="12" rx="6" class="c-pri" />
      <path d="M20 9v9M44 9v9" class="s-ink" />
      <path d="m23 40 6 6 12-12" class="s-acc draw" />
    </>
  )}
  {name === 'cloud' && (
    <>
      <g class="peek"><circle cx="40" cy="22" r="10" class="c-acc" />
        {[0, 60, 120, 180, 240, 300].map((a) => <path d="M40 6v4" class="s-acc" transform={`rotate(${a} 40 22)`} />)}
      </g>
      <g class="drift"><path d="M14 46a9 9 0 0 1 2-17.8A12 12 0 0 1 39 30a8 8 0 0 1 1 16z" class="c-soft" /></g>
      <path d="M22 52l-2 5M30 52l-2 5M38 52l-2 5" class="s-pri drop drop--1" />
    </>
  )}
  {name === 'cup' && (
    <>
      <path d="M38 6 34 24" class="s-acc" />
      <path d="M16 20h32l-4 34a4 4 0 0 1-4 3.5H24a4 4 0 0 1-4-3.5z" class="c-soft" />
      <path d="M18.5 34h27l-2.2 19.5a3 3 0 0 1-3 2.5H23.7a3 3 0 0 1-3-2.5z" class="c-pri" />
      <circle cx="28" cy="48" r="1.6" class="c-white bubble" />
      <circle cx="35" cy="50" r="1.2" class="c-white bubble bubble--2" />
      <circle cx="31" cy="44" r="1" class="c-white bubble bubble--3" />
      <circle cx="46" cy="22" r="5" class="c-acc" />
    </>
  )}
  {name === 'lifebuoy' && (
    <g class="spin spin--slow">
      <circle cx="32" cy="32" r="22" class="c-white" />
      <path d="M32 10a22 22 0 0 1 15.6 6.4L40 24a11 11 0 0 0-8-3.5zM54 32a22 22 0 0 1-6.4 15.6L40 40a11 11 0 0 0 3.5-8zM32 54a22 22 0 0 1-15.6-6.4L24 40a11 11 0 0 0 8 3.5zM10 32a22 22 0 0 1 6.4-15.6L24 24a11 11 0 0 0-3.5 8z" class="c-acc" />
      <circle cx="32" cy="32" r="22" class="s-pri" />
      <circle cx="32" cy="32" r="11" class="s-pri" />
    </g>
  )}
  {name === 'phone' && (
    <>
      <g class="ring">
        <path d="M18 10h7l3.5 9-4.5 3a26 26 0 0 0 11.5 11.5l3-4.5 9 3.5v7a4 4 0 0 1-4.4 4A40 40 0 0 1 14 14.4 4 4 0 0 1 18 10z" class="c-pri" />
      </g>
      <path d="M40 10a14 14 0 0 1 14 14" class="s-acc wave-arc" />
      <path d="M40 17a7 7 0 0 1 7 7" class="s-acc wave-arc wave-arc--2" />
    </>
  )}
  {name === 'mail' && (
    <>
      <rect x="8" y="16" width="48" height="34" rx="6" class="c-soft" />
      <path d="M8 22l24 16 24-16" class="s-pri" />
      <g class="flap"><path d="M10 18l22 15 22-15" class="s-pri" /></g>
      <circle cx="52" cy="16" r="6" class="c-acc pulse-dot" />
    </>
  )}
  {name === 'chat' && (
    <>
      <path d="M8 14a6 6 0 0 1 6-6h24a6 6 0 0 1 6 6v12a6 6 0 0 1-6 6H20l-8 6v-6.5A6 6 0 0 1 8 26z" class="c-pri" />
      <circle cx="18" cy="20" r="2.2" class="c-white dot" />
      <circle cx="26" cy="20" r="2.2" class="c-white dot dot--2" />
      <circle cx="34" cy="20" r="2.2" class="c-white dot dot--3" />
      <path d="M24 38a5 5 0 0 1 5-5h22a5 5 0 0 1 5 5v9a5 5 0 0 1-5 5v6l-7-6H29a5 5 0 0 1-5-5z" class="c-soft pop" />
      <path d="m32 43 4 4 8-8" class="s-pri" />
    </>
  )}
</svg>

<style>
  .ai {
    display: block;
    overflow: hidden;
    --a-pri: var(--primary, #0b6fd8);
    --a-soft: #bfdcfa;
    --a-acc: #f19f2b;
    --a-ink: #1f2a31;
  }
  .ai :global(.c-pri) { fill: var(--a-pri); }
  .ai :global(.c-soft) { fill: var(--a-soft); }
  .ai :global(.c-acc) { fill: var(--a-acc); }
  .ai :global(.c-ink) { fill: var(--a-ink); }
  .ai :global(.c-white) { fill: #fff; }
  .ai :global(.c-sun) { fill: #ffd27a; }
  .ai :global([class^='s-']),
  .ai :global([class*=' s-']) {
    fill: none;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .ai :global(.s-pri) { stroke: var(--a-pri); }
  .ai :global(.s-soft) { stroke: var(--a-soft); }
  .ai :global(.s-acc) { stroke: var(--a-acc); }
  .ai :global(.s-ink) { stroke: var(--a-ink); }
  .ai :global(.s-light) { stroke: rgba(255, 255, 255, 0.7); stroke-width: 1.5; }

  .ai :global(.bob) { animation: ai-bob 3s ease-in-out infinite; transform-origin: 32px 40px; }
  .ai :global(.bob--fast) { animation-duration: 0.6s; }
  .ai :global(.bob--late) { animation-delay: -1.5s; }
  .ai :global(.wave) { animation: ai-wave 2.4s linear infinite; }
  .ai :global(.wave--2) { animation-duration: 3.6s; }
  .ai :global(.wave--rev) { animation-direction: reverse; animation-duration: 3s; }
  .ai :global(.spin) { animation: ai-spin 14s linear infinite; transform-origin: 32px 32px; }
  .ai :global(.pulse) { animation: ai-pulse 3s ease-in-out infinite; transform-origin: 32px 32px; }
  .ai :global(.drift) { animation: ai-drift 6s ease-in-out infinite alternate; }
  .ai :global(.hand-m) { animation: ai-spin 4s linear infinite; transform-origin: 32px 32px; }
  .ai :global(.hand-h) { animation: ai-spin 48s linear infinite; transform-origin: 32px 32px; }
  .ai :global(.steam) { animation: ai-steam 2.4s ease-in-out infinite; }
  .ai :global(.steam--2) { animation-delay: -0.8s; }
  .ai :global(.steam--3) { animation-delay: -1.6s; }
  .ai :global(.arm) { animation: ai-arm 1.8s ease-in-out infinite; transform-origin: 33px 30px; }
  .ai :global(.draw) { stroke-dasharray: 40; animation: ai-draw 3s ease-in-out infinite; }
  .ai :global(.twinkle) { animation: ai-twinkle 2s ease-in-out infinite; transform-box: fill-box; transform-origin: center; }
  .ai :global(.twinkle--2) { animation-delay: -1s; }
  .ai :global(.hop) { animation: ai-hop 2s cubic-bezier(0.5, 0, 0.5, 1) infinite; }
  .ai :global(.shadow) { animation: ai-shadow 2s cubic-bezier(0.5, 0, 0.5, 1) infinite; transform-origin: 32px 56px; }
  .ai :global(.road) { animation: ai-road 0.8s linear infinite; }
  .ai :global(.wheel) { animation: ai-spin 0.8s linear infinite; }
  .ai :global(.drop) { animation: ai-drop 1.2s linear infinite; }
  .ai :global(.drop--2) { animation-delay: -0.3s; }
  .ai :global(.drop--3) { animation-delay: -0.6s; }
  .ai :global(.drop--4) { animation-delay: -0.9s; }
  .ai :global(.sway) { animation: ai-sway 3.2s ease-in-out infinite; transform-origin: 30px 48px; }
  .ai :global(.peek) { animation: ai-peek 4s ease-in-out infinite; }
  .ai :global(.bubble) { animation: ai-bubble 2s ease-in infinite; }
  .ai :global(.bubble--2) { animation-delay: -0.7s; }
  .ai :global(.bubble--3) { animation-delay: -1.3s; }
  .ai :global(.spin--slow) { animation-duration: 10s; }
  .ai :global(.dot) { animation: ai-dot 1.2s ease-in-out infinite; transform-box: fill-box; }
  .ai :global(.dot--2) { animation-delay: 0.15s; }
  .ai :global(.dot--3) { animation-delay: 0.3s; }
  .ai :global(.ring) { animation: ai-ring 2.4s ease-in-out infinite; transform-origin: 30px 32px; }
  .ai :global(.wave-arc) { animation: ai-fade 1.6s ease-in-out infinite; }
  .ai :global(.wave-arc--2) { animation-delay: 0.3s; }
  .ai :global(.flap) { animation: ai-flap 3s ease-in-out infinite; transform-origin: 32px 18px; }
  .ai :global(.pulse-dot) { animation: ai-pulse 1.6s ease-in-out infinite; transform-box: fill-box; transform-origin: center; }
  .ai :global(.pop) { animation: ai-pop 3s ease-in-out infinite; transform-origin: 40px 46px; }

  @keyframes ai-bob { 0%, 100% { transform: translateY(0) rotate(-2deg); } 50% { transform: translateY(-2.5px) rotate(2deg); } }
  @keyframes ai-wave { to { transform: translateX(16px); } }
  @keyframes ai-spin { to { transform: rotate(360deg); } }
  @keyframes ai-pulse { 50% { transform: scale(1.08); } }
  @keyframes ai-drift { to { transform: translateX(8px); } }
  @keyframes ai-steam { 0% { opacity: 0; transform: translateY(6px); } 40% { opacity: 1; } 100% { opacity: 0; transform: translateY(-6px); } }
  @keyframes ai-arm { 50% { transform: rotate(-14deg); } }
  @keyframes ai-draw { 0% { stroke-dashoffset: 40; } 45%, 85% { stroke-dashoffset: 0; } 100% { stroke-dashoffset: -40; } }
  @keyframes ai-twinkle { 50% { transform: scale(0.4); opacity: 0.4; } }
  @keyframes ai-hop { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-6px); } }
  @keyframes ai-shadow { 50% { transform: scale(0.7); opacity: 0.6; } }
  @keyframes ai-road { to { transform: translateX(-20px); } }
  @keyframes ai-sway { 0%, 100% { transform: rotate(-4deg); } 50% { transform: rotate(4deg); } }
  @keyframes ai-peek { 0%, 100% { transform: translate(0, 0); } 50% { transform: translate(-4px, -3px); } }
  @keyframes ai-bubble { 0% { transform: translateY(0); opacity: 0; } 20% { opacity: 1; } 100% { transform: translateY(-14px); opacity: 0; } }
  @keyframes ai-dot { 0%, 60%, 100% { transform: translateY(0); } 30% { transform: translateY(-3px); } }
  @keyframes ai-pop { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.05); } }
  @keyframes ai-ring { 0%, 50%, 100% { transform: rotate(0); } 5%, 15%, 25% { transform: rotate(-10deg); } 10%, 20%, 30% { transform: rotate(10deg); } }
  @keyframes ai-fade { 0%, 100% { opacity: 0.2; } 50% { opacity: 1; } }
  @keyframes ai-flap { 0%, 100% { transform: scaleY(1); } 50% { transform: scaleY(-0.6); } }
  @keyframes ai-drop { 0% { opacity: 0; transform: translateY(-4px); } 30% { opacity: 1; } 100% { opacity: 0; transform: translateY(10px); } }

  @media (prefers-reduced-motion: reduce) {
    .ai :global(*) { animation: none !important; }
  }
</style>
