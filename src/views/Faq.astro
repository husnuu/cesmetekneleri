---
import Base from '../layouts/Base.astro';
import PageBand from '../components/PageBand.astro';
import Icon from '../components/Icon.astro';
import AnimIcon from '../components/AnimIcon.astro';
import { ROUTES, SITE, waLink, type Lang } from '../site';
import { faqCategories } from '../data/faq';
import { sections } from '../i18n/sections';
import { t } from '../i18n';
import bandImg from '../assets/photos/akvaryum-koyu-yuzme.jpg';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const p = sections(lang).faqPage;
const cats = faqCategories(lang);
const url = (r: string) => new URL(r, SITE.url).href;
const seen = new Set<string>();
const unique = cats.flatMap((c) => c.items).filter((f) => (seen.has(f.q) ? false : (seen.add(f.q), true)));
const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: unique.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: d.breadcrumbHome, item: url(ROUTES.home[lang]) },
      { '@type': 'ListItem', position: 2, name: p.h1, item: url(ROUTES.faq[lang]) },
    ],
  },
];
---
<Base lang={lang} route="faq" title={p.title} description={p.desc} ogImage={bandImg} jsonld={jsonld}>
  <PageBand image={bandImg} eyebrow={p.eyebrow} title={p.h1} lead={p.lead} crumbs={[{ label: d.breadcrumbHome, href: ROUTES.home[lang] }, { label: p.h1 }]}>
    <label class="search">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
      <span class="sr-only">{p.search}</span>
      <input type="search" placeholder={p.search} data-faq-search autocomplete="off" />
    </label>
  </PageBand>

  <div class="wrap layout">
    <aside class="nav">
      <ul>
        {cats.map((c) => (
          <li>
            <a href={`#${c.id}`} data-cat-link={c.id}>
              <span class="nav__i"><AnimIcon name={c.icon} size={30} /></span>
              <span>{c.title}</span>
              <span class="nav__n">{c.items.length}</span>
            </a>
          </li>
        ))}
      </ul>
      <div class="still">
        <AnimIcon name="chat" size={48} />
        <h2>{p.stillTitle}</h2>
        <p>{p.stillText}</p>
        <a class="btn" href={waLink(d.waGreeting)} target="_blank" rel="noopener"><Icon name="whatsapp" />WhatsApp</a>
        <a class="btn btn--outline" href={`tel:${SITE.phoneHref}`}><Icon name="phone" />{SITE.phone}</a>
      </div>
    </aside>

    <div class="main">
      {cats.map((c) => (
        <section class="cat" id={c.id} data-cat={c.id}>
          <h2>{c.title}</h2>
          <div class="qa">
            {c.items.map((f) => (
              <details data-q>
                <summary><h3>{f.q}</h3><span class="qa__pm" aria-hidden="true"></span></summary>
                <p>{f.a}</p>
              </details>
            ))}
          </div>
        </section>
      ))}
      <p class="empty" hidden data-faq-empty>{p.empty}</p>
    </div>
  </div>
</Base>

<script>
  const input = document.querySelector<HTMLInputElement>('[data-faq-search]');
  const norm = (s: string) => s.toLocaleLowerCase('tr').normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/ı/g, 'i');
  input?.addEventListener('input', () => {
    const q = norm(input.value.trim());
    let any = false;
    document.querySelectorAll<HTMLElement>('[data-cat]').forEach((cat) => {
      let shown = 0;
      cat.querySelectorAll<HTMLDetailsElement>('[data-q]').forEach((d) => {
        const hit = !q || norm(d.textContent || '').includes(q);
        d.hidden = !hit;
        d.open = !!q && hit;
        if (hit) shown++;
      });
      cat.hidden = shown === 0;
      any ||= shown > 0;
    });
    document.querySelector<HTMLElement>('[data-faq-empty]')!.hidden = any;
  });
  // görünür kategoriyi menüde vurgula
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-cat-link]');
  const io = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (e.isIntersecting) links.forEach((l) => l.classList.toggle('is-active', l.dataset.catLink === (e.target as HTMLElement).dataset.cat));
    });
  }, { rootMargin: '-40% 0px -55% 0px' });
  document.querySelectorAll('[data-cat]').forEach((c) => io.observe(c));
</script>

<style>
  .search {
    position: relative;
    display: block;
    max-width: 36rem;
    margin-top: 2rem;
  }
  .search svg {
    position: absolute;
    left: 1.2rem;
    top: 50%;
    width: 1.25rem;
    height: 1.25rem;
    transform: translateY(-50%);
    color: var(--muted);
  }
  .search input {
    width: 100%;
    height: 3.75rem;
    padding: 0 1.25rem 0 3.25rem;
    border: 0;
    border-radius: 18px;
    background: #fff;
    font: 600 1rem var(--font);
    color: var(--ink-strong);
    box-shadow: var(--shadow-lg);
    outline: none;
  }
  .search input:focus {
    box-shadow: var(--shadow-lg), 0 0 0 4px rgba(20, 99, 216, 0.25);
  }

  .layout {
    display: grid;
    grid-template-columns: 300px minmax(0, 1fr);
    gap: 3rem;
    align-items: start;
    padding-block: 3.5rem var(--section);
  }
  .nav {
    position: sticky;
    top: 5.5rem;
    display: grid;
    gap: 1.5rem;
  }
  .nav ul {
    display: grid;
    gap: 0.25rem;
  }
  .nav a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.55rem 0.75rem;
    border-radius: 14px;
    font-weight: 700;
    font-size: 0.9375rem;
    color: var(--ink-strong);
    text-decoration: none;
    transition: background 0.2s;
  }
  .nav a:hover,
  .nav a.is-active {
    background: var(--bg-soft);
  }
  .nav a.is-active {
    color: var(--primary);
  }
  .nav__i {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 12px;
    background: var(--primary-soft);
  }
  .nav__n {
    margin-left: auto;
    min-width: 1.6rem;
    padding: 0.1rem 0.45rem;
    border-radius: 999px;
    background: var(--bg-soft);
    text-align: center;
    font-size: 0.75rem;
    color: var(--muted);
  }
  .still {
    display: grid;
    gap: 0.6rem;
    padding: 1.4rem;
    border-radius: var(--radius-lg);
    background: linear-gradient(160deg, var(--primary-soft), #fff 70%);
    border: 1px solid var(--line);
  }
  .still h2 {
    font-size: 1.125rem;
  }
  .still p {
    font-size: 0.875rem;
    color: var(--muted);
  }
  .still .btn {
    width: 100%;
  }

  .cat + .cat {
    margin-top: 3rem;
  }
  .cat h2 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
    scroll-margin-top: 6rem;
  }
  .cat {
    scroll-margin-top: 6rem;
  }
  .qa {
    display: grid;
    gap: 0.6rem;
  }
  .qa details {
    border-radius: var(--radius);
    background: #fff;
    border: 1px solid var(--line);
    padding: 0 1.4rem;
    transition: box-shadow 0.2s, border-color 0.2s;
  }
  .qa details:hover {
    border-color: #cfd8e3;
  }
  .qa details[open] {
    box-shadow: var(--shadow);
    border-color: transparent;
  }
  .qa summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    padding-block: 1.2rem;
    cursor: pointer;
  }
  .qa summary::-webkit-details-marker {
    display: none;
  }
  .qa summary h3 {
    font-size: 1.0625rem;
    font-weight: 700;
  }
  .qa__pm {
    position: relative;
    flex: none;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--primary-soft);
  }
  .qa__pm::before,
  .qa__pm::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0.8rem;
    height: 2px;
    border-radius: 2px;
    background: var(--primary);
    transform: translate(-50%, -50%);
    transition: transform 0.25s;
  }
  .qa__pm::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }
  details[open] .qa__pm::after {
    transform: translate(-50%, -50%) rotate(0);
  }
  .qa details p {
    padding-bottom: 1.3rem;
    max-width: 46rem;
    color: var(--ink);
  }
  .empty {
    padding: 2rem;
    text-align: center;
    color: var(--muted);
  }
  @media (max-width: 960px) {
    .layout {
      grid-template-columns: 1fr;
    }
    .nav {
      position: static;
    }
    .nav ul {
      display: flex;
      overflow-x: auto;
      gap: 0.5rem;
      scrollbar-width: none;
    }
    .nav a {
      white-space: nowrap;
      background: var(--bg-soft);
    }
    .nav__n {
      display: none;
    }
    .still {
      display: none;
    }
  }
</style>
