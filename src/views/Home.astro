---
import { Image, Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import BookingWidget from '../components/BookingWidget.astro';
import Title from '../components/Title.astro';
import AnimIcon from '../components/AnimIcon.astro';
import Reviews from '../components/home/Reviews.astro';
import Coves from '../components/home/Coves.astro';
import Perks from '../components/home/Perks.astro';
import TourCards from '../components/TourCards.astro';
import Icon from '../components/Icon.astro';
import Blog from '../components/home/Blog.astro';
import WaBand from '../components/home/WaBand.astro';
import AboutCollage from '../components/home/AboutCollage.astro';
import { LOCALE, ROUTES, SITE, fmtNum, type Lang } from '../site';
import { t } from '../i18n';
import { alts } from '../i18n/alts';
import { RATING, sections } from '../i18n/sections';
import { TOURS } from '../data/tours';
import { faqCategories } from '../data/faq';

import hero from '../assets/photos/cesme-koy-tekne-adalar.jpg';
import refTursab from '../assets/refs/tursab.png';
import refImeak from '../assets/refs/imeak-dto.png';
import refEts from '../assets/refs/etstur.svg';
import refEcz from '../assets/refs/eczacibasi.png';
import refGoz from '../assets/refs/goztepe.png';
import firstClass from '../assets/photos/first-class-bungalov.jpg';
import topDeck from '../assets/photos/ust-guverte-sezlong.jpg';
import cruising from '../assets/photos/cesme-tur-teknesi-seyir.jpg';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const h = d.home;
const u = d.ui;
const s = sections(lang);
const deckImgs = [firstClass, topDeck, cruising];
const whyIcons = ['boat', 'grill', 'swim', 'shield'] as const;
const extraIcons = ['bus', 'cup', 'shower'] as const;
const refs = [
  { src: refTursab, name: 'TÜRSAB – Türkiye Seyahat Acentaları Birliği', h: 46 },
  { src: refImeak, name: 'İMEAK Deniz Ticaret Odası', h: 38 },
  { src: refEts, name: 'ETS Tur', h: 24 },
  { src: refEcz, name: 'Eczacıbaşı', h: 40 },
  { src: refGoz, name: 'Göztepe Spor Kulübü', h: 64 },
];
const alt = alts(lang);

const fc = faqCategories(lang);
const homeFaq = [...fc[0].items.slice(0, 3), ...fc[1].items.slice(0, 3)];
const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: u.toursTitle.join('').trim(),
    itemListElement: TOURS.map((tr, i) => ({ '@type': 'ListItem', position: i + 1, name: tr[lang].title, url: new URL(ROUTES[tr.key][lang], SITE.url).href })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: homeFaq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<Base lang={lang} route="home" title={h.title} description={h.description} ogImage={hero} jsonld={jsonld}>
  <section class="hero">
    <div class="hero__frame">
      <Picture src={hero} formats={['avif', 'webp']} widths={[768, 1280, 1920, 2560]} quality={72} sizes="100vw" alt={alt.hero} loading="eager" fetchpriority="high" class="hero__img" />
      <div class="hero__shade" aria-hidden="true"></div>
      <div class="wrap hero__content">
        <div class="hero__text">
          <p class="hero__rate"><span class="hero__stars" aria-hidden="true">★★★★★</span><b>{RATING.value.toLocaleString(LOCALE[lang].intl)}</b><span>·</span>{fmtNum(RATING.count, lang)}+ {u.reviewsWord}</p>
          <p class="hero__kicker">{u.heroLine1}</p>
          <h1>{u.heroNewest}</h1>
          <p class="hero__lead" data-speakable>{u.heroText}</p>
        </div>
        <ul class="hero__chips" aria-hidden="true">
          <li><Icon name="clock" />{u.heroChip1}</li>
          <li><Icon name="pin" />{u.heroChip2}</li>
        </ul>
      </div>
    </div>
  </section>

  <div class="wrap widget">
    <BookingWidget lang={lang} />
  </div>

  <section class="section tours">
    <div class="wrap">
      <div class="tours__head">
        <div>
          <p class="eyebrow">{u.eyebrowTours}</p>
          <Title parts={u.toursTitle} class="title--lg" />
          <p class="sub">{u.toursText}</p>
        </div>
        <a class="btn btn--outline" href={ROUTES.tours[lang]}>{u.allTours}<Icon name="arrow" /></a>
      </div>
      <TourCards lang={lang} />
    </div>
  </section>

  <Reviews lang={lang} />

  <section class="section why-sec">
    <div class="wrap">
      <div class="split">
        <Title parts={u.whyTitle} class="title--lg" />
        <p class="sub">{u.whyText}</p>
      </div>
      <ul class="why">
        {u.why.map((w, i) => (
          <li>
            <span class="why__n">0{i + 1}</span>
            <span class="why__i"><AnimIcon name={whyIcons[i]} size={40} /></span>
            <h3>{w.t}</h3>
            <p>{w.d}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section refs">
    <div class="wrap">
      <Title parts={u.refsTitle} center class="title--lg" />
      <p class="sub">{h.refsText}</p>
      <ul class="refs__row">
        {refs.map((r) => (
          <li><Image src={r.src} alt={r.name} height={r.h * 2} style={`height:${r.h}px`} loading="lazy" /></li>
        ))}
      </ul>
    </div>
  </section>

  <Coves lang={lang} />

  <section class="section">
    <div class="wrap">
      <Title parts={u.decksTitle} center class="title--lg" />
      <p class="sub">{h.decksText}</p>
      <div class="decks">
        {h.decks.map((dk, i) => (
          <article class:list={['deck', { 'deck--first': i === 0 }]}>
            <Image src={deckImgs[i]} alt={alt.decks[i]} widths={[480, 720, 960]} sizes="(max-width: 860px) 100vw, 33vw" />
            <div class="deck__body">
              <span class="deck__tag">{dk.tag}</span>
              <h3>{dk.name}</h3>
              <p>{dk.text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <Perks lang={lang} />

  <section class="section">
    <div class="wrap">
      <Title parts={s.extras.title} center class="title--lg" />
      <ul class="extras">
        {s.extras.items.map((e, i) => (
          <li>
            <span class="extras__i"><AnimIcon name={extraIcons[i]} size={40} /></span>
            <div><h3>{e.t}</h3><p>{e.d}</p></div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--soft hfaq">
    <div class="wrap hfaq__grid">
      <div>
        <p class="eyebrow">{s.faqPage.eyebrow}</p>
        <Title parts={['', s.td.faq, '']} class="title--lg" />
        <p class="sub">{s.faqPage.lead}</p>
        <a class="btn btn--outline" href={ROUTES.faq[lang]}>{s.td.allFaq}<Icon name="arrow" /></a>
      </div>
      <div class="hfaq__list">
        {homeFaq.map((f, i) => (
          <details open={i === 0}>
            <summary><h3>{f.q}</h3><span class="hfaq__pm" aria-hidden="true"></span></summary>
            <p data-speakable>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <Blog lang={lang} />
  <WaBand lang={lang} />
  <AboutCollage lang={lang} />
</Base>

<style>
  .hero {
    padding: 0 clamp(0.5rem, 1.2vw, 1rem);
  }
  .hero__frame {
    position: relative;
    height: clamp(560px, 70vh, 760px);
    border-radius: 0 0 32px 32px;
    overflow: hidden;
    background: var(--navy);
    isolation: isolate;
  }
  .hero :global(.hero__img) {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 62%;
    animation: kenburns 24s ease-out both;
  }
  @keyframes kenburns {
    from { transform: scale(1.1); }
    to { transform: scale(1); }
  }
  .hero__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to top, rgba(6, 20, 42, 0.78) 0%, rgba(6, 20, 42, 0.25) 42%, rgba(6, 20, 42, 0) 62%),
      linear-gradient(to bottom, rgba(6, 20, 42, 0.35), rgba(6, 20, 42, 0) 22%);
  }
  .hero__content {
    position: absolute;
    left: 0;
    right: 0;
    bottom: clamp(6.5rem, 11vw, 8rem);
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    color: #fff;
  }
  .hero__text {
    max-width: 34rem;
    animation: rise 0.9s 0.15s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  @keyframes rise {
    from { opacity: 0; transform: translateY(18px); }
  }
  .hero__rate {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.22);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    font-size: 0.8125rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.9);
  }
  .hero__stars {
    color: #ffc95c;
    letter-spacing: 0.06em;
  }
  .hero__rate b {
    color: #fff;
  }
  .hero__kicker {
    margin-top: 1.4rem;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #e6c98f;
  }
  .hero h1 {
    margin-top: 0.5rem;
    color: #fff;
    font-size: clamp(1.9rem, 3.4vw, 2.7rem);
    font-weight: 750;
    line-height: 1.12;
    letter-spacing: -0.03em;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.25);
  }
  .hero__lead {
    margin-top: 0.8rem;
    max-width: 28rem;
    font-size: 1rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.85);
  }
  .hero__chips {
    display: grid;
    gap: 0.5rem;
    justify-items: end;
    animation: rise 0.9s 0.35s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  .hero__chips li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0.9rem;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.92);
    color: var(--ink-strong);
    font-size: 0.8125rem;
    font-weight: 700;
    box-shadow: 0 12px 30px -12px rgba(0, 0, 0, 0.4);
  }
  .hero__chips :global(svg) {
    width: 1rem;
    height: 1rem;
    color: var(--primary);
  }
  @media (prefers-reduced-motion: reduce) {
    .hero :global(.hero__img),
    .hero__text,
    .hero__chips {
      animation: none;
    }
  }

  .hfaq__grid {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 2.5rem 4rem;
    align-items: start;
  }
  .hfaq__grid > div:first-child {
    display: grid;
    gap: 1rem;
    justify-items: start;
    position: sticky;
    top: 6rem;
  }
  .hfaq__grid .sub {
    margin: 0 0 0.5rem;
  }
  .hfaq__list {
    display: grid;
    gap: 0.6rem;
  }
  .hfaq__list details {
    padding: 0 1.4rem;
    border-radius: var(--radius);
    background: #fff;
    border: 1px solid var(--line);
    transition: box-shadow 0.2s;
  }
  .hfaq__list details[open] {
    box-shadow: var(--shadow);
    border-color: transparent;
  }
  .hfaq__list summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.15rem;
    cursor: pointer;
  }
  .hfaq__list summary::-webkit-details-marker {
    display: none;
  }
  .hfaq__list summary h3 {
    font-size: 1.0625rem;
  }
  .hfaq__pm {
    position: relative;
    flex: none;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 50%;
    background: var(--primary-soft);
  }
  .hfaq__pm::before,
  .hfaq__pm::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0.75rem;
    height: 2px;
    border-radius: 2px;
    background: var(--primary);
    transform: translate(-50%, -50%);
    transition: transform 0.25s;
  }
  .hfaq__pm::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }
  details[open] .hfaq__pm::after {
    transform: translate(-50%, -50%) rotate(0);
  }
  .hfaq__list details p {
    padding-bottom: 1.2rem;
    color: var(--ink);
  }
  @media (max-width: 860px) {
    .hfaq__grid {
      grid-template-columns: 1fr;
    }
    .hfaq__grid > div:first-child {
      position: static;
    }
  }

  .widget {
    position: relative;
    z-index: 5;
    margin-top: -3.4rem;
    max-width: calc(1060px + var(--gutter) * 2);
  }
  .tours {
    padding-top: clamp(3.5rem, 7vw, 5rem);
  }
  .tours__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    margin-bottom: 2.25rem;
  }
  .tours__head .eyebrow {
    margin-bottom: 0.75rem;
  }

  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem 3rem;
    align-items: end;
    margin-bottom: 2.5rem;
  }
  .split .sub {
    margin: 0;
    justify-self: end;
    max-width: 28rem;
  }
  .why {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--line);
  }
  .why li {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.6rem;
    padding: 1.75rem 1.5rem 0.5rem 0;
  }
  .why li + li {
    padding-left: 1.5rem;
    border-left: 1px solid var(--line);
  }
  .why__n {
    position: absolute;
    top: 1.75rem;
    right: 1.25rem;
    font-size: 0.75rem;
    font-weight: 800;
    color: #c3cad3;
    font-variant-numeric: tabular-nums;
  }
  .why__i,
  .extras__i {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 14px;
    background: var(--bg-soft);
    margin-bottom: 0.4rem;
  }
  .why h3 {
    font-size: 1.0625rem;
  }
  .why p {
    font-size: 0.9rem;
    color: var(--muted);
  }

  .refs {
    padding-top: 0;
  }
  .refs__row {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    margin-top: 2.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .refs__row li {
    display: grid;
    place-items: center;
    height: 7rem;
    padding: 1rem;
  }
  .refs__row li + li {
    border-left: 1px solid var(--line);
  }
  .refs__row :global(img) {
    width: auto;
    max-width: 100%;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.65;
    transition: filter 0.3s, opacity 0.3s;
  }
  .refs__row li:hover :global(img) {
    filter: none;
    opacity: 1;
  }

  .decks {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    margin-top: 2.5rem;
  }
  .deck {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-lg);
    min-height: 26rem;
    display: flex;
    align-items: flex-end;
    color: #fff;
    isolation: isolate;
  }
  .deck :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
    transition: transform 0.9s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .deck::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to top, rgba(7, 21, 40, 0.88) 0%, rgba(7, 21, 40, 0.35) 45%, rgba(7, 21, 40, 0) 70%);
  }
  .deck:hover :global(img) {
    transform: scale(1.05);
  }
  .deck__body {
    display: grid;
    gap: 0.45rem;
    padding: 1.5rem;
  }
  .deck__tag {
    justify-self: start;
    padding: 0.28rem 0.65rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.16);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    font-size: 0.75rem;
    font-weight: 700;
  }
  .deck--first .deck__tag {
    background: #e6c98f;
    color: var(--navy);
  }
  .deck h3 {
    color: #fff;
    font-size: 1.5rem;
  }
  .deck p {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.82);
  }

  .extras {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-top: 2.5rem;
  }
  .extras li {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1.4rem;
    border-radius: var(--radius-lg);
    background: var(--bg-soft);
  }
  .extras__i {
    flex: none;
    background: #fff;
    margin: 0;
  }
  .extras h3 {
    font-size: 1.0625rem;
    margin-bottom: 0.3rem;
  }
  .extras p {
    font-size: 0.9rem;
    color: var(--muted);
  }


  @media (max-width: 1100px) {
    .why {
      grid-template-columns: 1fr 1fr;
    }
    .why li:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }
    .why li:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
    .refs__row {
      grid-template-columns: repeat(3, 1fr);
    }
    .refs__row li:nth-child(4) {
      border-left: 0;
    }
    .refs__row li:nth-child(n + 4) {
      border-top: 1px solid var(--line);
    }
  }
  @media (max-width: 860px) {
    .split {
      grid-template-columns: 1fr;
    }
    .split .sub {
      justify-self: start;
    }
    .decks {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      margin-inline: calc(var(--gutter) * -1);
      padding: 0 var(--gutter);
      scroll-padding-inline: var(--gutter);
    }
    .deck {
      flex: none;
      width: 80%;
      min-height: 24rem;
      scroll-snap-align: start;
    }
    .extras {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 640px) {
    .hero {
      padding: 0;
    }
    .hero__frame {
      height: 600px;
      border-radius: 0 0 26px 26px;
    }
    .hero :global(.hero__img) {
      object-position: 62% 60%;
    }
    .hero__content {
      bottom: 5.5rem;
    }
    .hero__chips {
      display: none;
    }
    .hero__lead {
      font-size: 0.9375rem;
    }
    .widget {
      margin-top: -3rem;
    }
    .why {
      grid-template-columns: 1fr;
    }
    .why li,
    .why li + li {
      display: grid;
      grid-template-columns: auto 1fr;
      grid-template-areas: 'i t' 'i p';
      column-gap: 1rem;
      padding: 1.25rem 0;
      border-left: 0;
      border-top: 1px solid var(--line);
    }
    .why li:first-child {
      border-top: 0;
    }
    .why__i {
      grid-area: i;
      margin: 0;
    }
    .why h3 {
      grid-area: t;
    }
    .why p {
      grid-area: p;
    }
    .why__n {
      top: 1.25rem;
      right: 0;
    }
    .refs__row {
      grid-template-columns: 1fr 1fr;
    }
    .refs__row li:nth-child(n) {
      border-left: 0;
      border-top: 1px solid var(--line);
      height: 5.5rem;
    }
    .refs__row li:nth-child(even) {
      border-left: 1px solid var(--line);
    }
    .refs__row li:nth-child(-n + 2) {
      border-top: 0;
    }
    .refs__row li:last-child {
      grid-column: 1 / -1;
      border-left: 0;
    }
  }
</style>
